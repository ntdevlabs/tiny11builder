<Window
    x:Class="Tiny11Builder.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Tiny11Builder.App"
    Title="Tiny11 Builder">
    <Window.SystemBackdrop><MicaBackdrop Kind="BaseAlt"/></Window.SystemBackdrop>
    <Grid x:Name="Root">
        <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid x:Name="TitleArea" Padding="24,0,140,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE7F8;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
            <TextBlock Grid.Column="1" Text="{loc:Tr Key=App__Title}" VerticalAlignment="Center" FontWeight="SemiBold"/>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="248"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid Padding="16,24,16,20">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Spacing="8">
                    <TextBlock Text="{loc:Tr Key=Nav__BuildSteps}" FontSize="10" CharacterSpacing="160"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" Margin="14,0,0,18"/>
                    <ListView x:Name="StepRail" SelectionChanged="OnRailChanged">
                        <ListViewItem Tag="0"><StackPanel Orientation="Horizontal" Spacing="14"><TextBlock Text="1" FontFamily="Consolas"/><TextBlock Text="{loc:Tr Key=Nav__Welcome}"/></StackPanel></ListViewItem>
                        <ListViewItem Tag="1"><StackPanel Orientation="Horizontal" Spacing="14"><TextBlock Text="2" FontFamily="Consolas"/><TextBlock Text="{loc:Tr Key=Nav__WindowsImage}"/></StackPanel></ListViewItem>
                        <ListViewItem Tag="2"><StackPanel Orientation="Horizontal" Spacing="14"><TextBlock Text="3" FontFamily="Consolas"/><TextBlock Text="{loc:Tr Key=Nav__RemoveComponents}"/></StackPanel></ListViewItem>
                        <ListViewItem Tag="3"><StackPanel Orientation="Horizontal" Spacing="14"><TextBlock Text="4" FontFamily="Consolas"/><TextBlock Text="{loc:Tr Key=Nav__BuildSettings}"/></StackPanel></ListViewItem>
                        <ListViewItem Tag="4"><StackPanel Orientation="Horizontal" Spacing="14"><TextBlock Text="5" FontFamily="Consolas"/><TextBlock Text="{loc:Tr Key=Nav__Review}"/></StackPanel></ListViewItem>
                        <ListViewItem Tag="5"><StackPanel Orientation="Horizontal" Spacing="14"><TextBlock Text="6" FontFamily="Consolas"/><TextBlock Text="{loc:Tr Key=Nav__CreateImage}"/></StackPanel></ListViewItem>
                    </ListView>
                </StackPanel>
                <StackPanel Grid.Row="2" Spacing="12">
                    <Border Style="{StaticResource Card}" Padding="16">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{loc:Tr Key=Nav__SelectedImage}" FontSize="10" CharacterSpacing="120"/>
                            <TextBlock x:Name="ImageBadge" Text="{loc:Tr Key=Image__None}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{loc:Tr Key=Nav__SourceUnchanged}" FontSize="12" Style="{StaticResource Secondary}"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="ResumeButton" Content="{loc:Tr Key=Action__ResumeBuild}" Click="OnResume" HorizontalAlignment="Stretch"
                            AutomationProperties.HelpText="{loc:Tr Key=Action__ResumeBuild__Help}"/>
                    <Button x:Name="RecoverButton" Content="{loc:Tr Key=Action__RecoverWorkspace}" Click="OnRecover" HorizontalAlignment="Stretch"/>
                    <ComboBox x:Name="ThemeChoice" Header="{loc:Tr Key=Nav__Appearance}" SelectionChanged="OnThemeChanged" HorizontalAlignment="Stretch" SelectedIndex="0">
                        <ComboBoxItem Content="{loc:Tr Key=Common__System}"/><ComboBoxItem Content="{loc:Tr Key=Common__Light}"/><ComboBoxItem Content="{loc:Tr Key=Common__Dark}"/>
                    </ComboBox>
                    <ComboBox x:Name="LanguageChoice" Header="{loc:Tr Key=Language__Header}" SelectionChanged="OnLanguageChanged"
                              HorizontalAlignment="Stretch" DisplayMemberPath="DisplayName"/>
                    <StackPanel Spacing="4">
                        <HyperlinkButton x:Name="SupportButton" Content="{loc:Tr Key=Support__Development}" Click="OnSupport" Padding="0"
                                         AutomationProperties.HelpText="{loc:Tr Key=Support__Development__Help}"/>
                        <HyperlinkButton Content="{loc:Tr Key=Nav__UpstreamProject}" NavigateUri="https://github.com/ntdevlabs/tiny11builder" Padding="0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
            <Grid Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="16,0,0,0"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,0">
                <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <!-- The fixed shell row: Back on the left, Cancel on the right, above the scrolling page and its watermark. -->
                <Grid x:Name="ShellRow" Padding="28,0,28,0" ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button x:Name="BackButton" Click="OnBack" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,12,0,0"
                            Background="Transparent" BorderThickness="0" Padding="12,8" AutomationProperties.Name="{loc:Tr Key=Common__Back}">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE72B;" FontSize="16" Opacity="{ThemeResource SubtleIconOpacity}"/>
                                <TextBlock Text="{loc:Tr Key=Common__Back}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Button.Content>
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Left" Modifiers="Menu"/>
                        </Button.KeyboardAccelerators>
                    </Button>
                    <TextBlock x:Name="BusyText" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,12,0,0" IsHitTestVisible="False"
                               Style="{StaticResource Secondary}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                               FontSize="12" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
                    <Button x:Name="CancelButton" Grid.Column="2" Style="{StaticResource CriticalButtonStyle}" Visibility="Collapsed" Click="OnCancel"
                            VerticalAlignment="Top" Margin="0,12,0,0" Padding="14,8" AutomationProperties.Name="{loc:Tr Key=Common__CancelSafely}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE711;" FontSize="14"/>
                            <TextBlock Text="{loc:Tr Key=Common__CancelSafely}"/>
                        </StackPanel>
                    </Button>
                </Grid>
                <InfoBar x:Name="Notice" Grid.Row="1" IsOpen="False" IsClosable="True" Margin="32,12,32,0">
                    <InfoBar.ActionButton>
                        <Button x:Name="NoticeButton" Click="OnNoticeAction" Visibility="Collapsed"/>
                    </InfoBar.ActionButton>
                </InfoBar>
                <ScrollViewer x:Name="ContentScroller" Grid.Row="2" Padding="40,24,40,20" HorizontalScrollBarVisibility="Disabled"
                              SizeChanged="OnContentSizeChanged" ViewChanged="OnContentViewChanged">
                    <Grid HorizontalAlignment="Stretch">
                        <Grid x:Name="WelcomePanel" RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Spacing="8">
                                <TextBlock x:Name="WelcomeTitle" Text="{loc:Tr Key=Welcome__Title}" FontSize="56" FontWeight="Light" Opacity="{ThemeResource WelcomeTitleOpacity}"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="Wrap"
                                           AutomationProperties.HeadingLevel="Level1"/>
                                <TextBlock Text="{loc:Tr Key=Welcome__Lead}"
                                           FontSize="16" Style="{StaticResource Secondary}"/>
                            </StackPanel>
                            <Grid Grid.Row="1" RowSpacing="12">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <TextBlock Text="{loc:Tr Key=Welcome__BuildModes}" FontSize="18" FontWeight="SemiBold"/>
                                <Grid x:Name="ModeCards" Grid.Row="1" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/><RowDefinition Height="0"/><RowDefinition Height="0"/>
                                    </Grid.RowDefinitions>
                                    <Button x:Name="RegularModeCard" Style="{StaticResource ModeCard}" Tag="Tiny11" Click="OnModeCardClick"
                                            AutomationProperties.Name="{loc:Tr Key=Mode__Tiny11}" AutomationProperties.HelpText="{loc:Tr Key=Welcome__ModeHelp__Tiny11}">
                                        <Grid RowSpacing="12">
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <FontIcon Glyph="&#xE7F4;" FontSize="64" HorizontalAlignment="Left"
                                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                            <StackPanel Grid.Row="1" Spacing="10">
                                                <TextBlock Text="{loc:Tr Key=Mode__Tiny11}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Text="{loc:Tr Key=Welcome__Tiny11__Description}"
                                                           Style="{StaticResource Secondary}" FontSize="13"/>
                                            </StackPanel>
                                            <TextBlock Grid.Row="2" Text="{loc:Tr Key=Welcome__Tiny11__Badge}" FontSize="12" TextWrapping="Wrap"
                                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                        </Grid>
                                    </Button>
                                    <Button x:Name="CoreModeCard" Grid.Column="1" Style="{StaticResource ModeCard}" Tag="Tiny11Core" Click="OnModeCardClick"
                                            AutomationProperties.Name="{loc:Tr Key=Mode__Core}" AutomationProperties.HelpText="{loc:Tr Key=Welcome__ModeHelp__Core}">
                                        <Grid RowSpacing="12">
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <FontIcon Glyph="&#xE8B7;" FontSize="64" HorizontalAlignment="Left"
                                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                            <StackPanel Grid.Row="1" Spacing="10">
                                                <TextBlock Text="{loc:Tr Key=Mode__Core}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Text="{loc:Tr Key=Welcome__Core__Description}"
                                                           Style="{StaticResource Secondary}" FontSize="13"/>
                                            </StackPanel>
                                            <TextBlock Grid.Row="2" Text="{loc:Tr Key=Welcome__Core__Badge}" FontSize="12" TextWrapping="Wrap"
                                                       Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                                        </Grid>
                                    </Button>
                                    <Button x:Name="CustomModeCard" Grid.Column="2" Style="{StaticResource ModeCard}" Tag="Custom" Click="OnModeCardClick"
                                            AutomationProperties.Name="{loc:Tr Key=Mode__Custom}" AutomationProperties.HelpText="{loc:Tr Key=Welcome__ModeHelp__Custom}">
                                        <Grid RowSpacing="12">
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <FontIcon Glyph="&#xE713;" FontSize="64" HorizontalAlignment="Left"
                                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                            <StackPanel Grid.Row="1" Spacing="10">
                                                <TextBlock Text="{loc:Tr Key=Mode__Custom}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Text="{loc:Tr Key=Welcome__Custom__Description}"
                                                           Style="{StaticResource Secondary}" FontSize="13"/>
                                            </StackPanel>
                                            <TextBlock Grid.Row="2" Text="{loc:Tr Key=Welcome__Custom__Badge}" FontSize="12" TextWrapping="Wrap"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </Grid>
                                    </Button>
                                </Grid>
                            </Grid>
                            <Grid Grid.Row="2" Padding="0,16,0,0">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{loc:Tr Key=Welcome__Compatibility}" FontSize="13" TextWrapping="Wrap"/>
                                    <TextBlock Text="{loc:Tr Key=Welcome__TestWarning}"
                                               Style="{StaticResource Secondary}" FontSize="12"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                        <StackPanel x:Name="SourcePanel" Visibility="Collapsed" Spacing="20">
                            <TextBlock Text="{loc:Tr Key=Source__Heading}" Style="{StaticResource PageHeading}"/>
                            <TextBlock x:Name="SourceMode" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontSize="13"/>
                            <TextBlock Text="{loc:Tr Key=Source__Lead}"
                                       Style="{StaticResource Secondary}"/>
                            <Grid x:Name="SourceCards" ColumnSpacing="16" RowSpacing="20">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="0"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Border x:Name="LocalMediaCard" Grid.Row="1" Style="{StaticResource Card}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="{loc:Tr Key=Source__Local__Title}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <TextBox x:Name="SourcePathBox" Header="{loc:Tr Key=Source__Local__PathHeader}" TextChanged="OnSourceChanged" PlaceholderText="{loc:Tr Key=Source__Local__PathPlaceholder}"/>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button Content="{loc:Tr Key=Source__Local__ChooseIso}" Click="OnChooseIso"/>
                                        <Button Content="{loc:Tr Key=Source__Local__ChooseFolder}" Click="OnChooseSourceFolder"/>
                                        <Button Content="{loc:Tr Key=Source__Local__Inspect}" Click="OnInspect" Style="{StaticResource AccentButtonStyle}"/>
                                    </StackPanel>
                                    <ComboBox x:Name="EditionChoice" Header="{loc:Tr Key=Source__Local__EditionHeader}" DisplayMemberPath="Summary"
                                              SelectionChanged="OnEditionChanged" HorizontalAlignment="Stretch"/>
                                </StackPanel>
                            </Border>
                            <Grid x:Name="DownloadCard" RowSpacing="12">
                                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Button Style="{StaticResource ModeCard}" MinHeight="150" Click="OnDownloadLatest" AutomationProperties.Name="{loc:Tr Key=Source__Download__Title}">
                                    <Grid ColumnSpacing="24" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE896;" FontSize="52" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                        <StackPanel Grid.Column="1" Spacing="8">
                                            <TextBlock Text="{loc:Tr Key=Source__Download__Title}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock x:Name="LatestDownloadDescription" Text="{loc:Tr Key=Source__Download__Description}" Style="{StaticResource Secondary}"/>
                                        </StackPanel>
                                        <FontIcon Grid.Column="2" Glyph="&#xE72A;" FontSize="24" Opacity="{ThemeResource CardArrowOpacity}"/>
                                    </Grid>
                                </Button>
                                <ProgressBar Grid.Row="1" x:Name="DownloadBar" Minimum="0" Maximum="100" Value="0" AutomationProperties.Name="{loc:Tr Key=Common__DownloadProgress}"/>
                                <TextBlock Grid.Row="2" x:Name="DownloadStatus" Text="{loc:Tr Key=Source__Download__InitialStatus}" Style="{StaticResource Secondary}"/>
                            </Grid>
                            </Grid>
                            <Expander Header="{loc:Tr Key=Source__Other__Header}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="{loc:Tr Key=Source__Other__Lead}"
                                               Style="{StaticResource Secondary}"/>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <HyperlinkButton Content="{loc:Tr Key=Source__Other__X64}" NavigateUri="https://www.microsoft.com/software-download/windows11"/>
                                        <HyperlinkButton Content="{loc:Tr Key=Source__Other__Arm64}" NavigateUri="https://www.microsoft.com/software-download/windows11arm64"/>
                                    </StackPanel>
                                    <HyperlinkButton Content="{loc:Tr Key=Source__Other__Insider}" NavigateUri="https://www.microsoft.com/software-download/windowsinsiderpreviewiso" Padding="0"/>
                                    <TextBox x:Name="DownloadUrlBox" Header="{loc:Tr Key=Source__Other__UrlHeader}" PlaceholderText="https://software.download.prss.microsoft.com/...iso?..."/>
                                    <TextBox x:Name="PublishedHashBox" Header="{loc:Tr Key=Source__Other__HashHeader}" PlaceholderText="{loc:Tr Key=Source__Other__HashPlaceholder}"/>
                                    <Button Content="{loc:Tr Key=Source__Other__Download}" Click="OnDownload" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                        <StackPanel x:Name="CleanupPanel" Visibility="Collapsed" Spacing="18">
                            <TextBlock Text="{loc:Tr Key=Components__Heading}" Style="{StaticResource PageHeading}"/>
                            <TextBlock Text="{loc:Tr Key=Components__Lead}" Style="{StaticResource Secondary}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel Spacing="14">
                                    <ComboBox x:Name="ModeChoice" Visibility="Collapsed" SelectionChanged="OnModeChanged" SelectedIndex="0">
                                        <ComboBoxItem Content="{loc:Tr Key=Mode__Tiny11}"/>
                                        <ComboBoxItem Content="{loc:Tr Key=Mode__Core}"/>
                                        <ComboBoxItem Content="{loc:Tr Key=Mode__Custom}"/>
                                    </ComboBox>
                                    <Grid x:Name="RemovalModeCards" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="0"/><RowDefinition Height="0"/></Grid.RowDefinitions>
                                        <Button x:Name="Tiny11Selection" Style="{StaticResource ModeCard}" MinHeight="140" Click="OnRemovalModeClick" Tag="Tiny11" AutomationProperties.Name="{loc:Tr Key=Components__Use__Tiny11}">
                                            <StackPanel Spacing="12"><FontIcon Glyph="&#xE7F4;" FontSize="48" HorizontalAlignment="Left"/><TextBlock Text="{loc:Tr Key=Mode__Tiny11}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{loc:Tr Key=Components__Card__Tiny11__Description}" Style="{StaticResource Secondary}"/></StackPanel>
                                        </Button>
                                        <Button x:Name="CoreSelection" Grid.Column="1" Style="{StaticResource ModeCard}" MinHeight="140" Click="OnRemovalModeClick" Tag="Tiny11Core" AutomationProperties.Name="{loc:Tr Key=Components__Use__Core}">
                                            <StackPanel Spacing="12"><FontIcon Glyph="&#xE8B7;" FontSize="48" HorizontalAlignment="Left"/><TextBlock Text="{loc:Tr Key=Mode__Core}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{loc:Tr Key=Components__Card__Core__Description}" Style="{StaticResource Secondary}"/></StackPanel>
                                        </Button>
                                        <Button x:Name="CustomSelection" Grid.Column="2" Style="{StaticResource ModeCard}" MinHeight="140" Click="OnRemovalModeClick" Tag="Custom" AutomationProperties.Name="{loc:Tr Key=Components__Use__Custom}">
                                            <StackPanel Spacing="12"><FontIcon Glyph="&#xE713;" FontSize="48" HorizontalAlignment="Left"/><TextBlock Text="{loc:Tr Key=Mode__Custom}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{loc:Tr Key=Components__Card__Custom__Description}" Style="{StaticResource Secondary}"/></StackPanel>
                                        </Button>
                                    </Grid>
                                    <TextBlock x:Name="ModeDescription" Style="{StaticResource Secondary}"/>
                                    <InfoBar x:Name="CoreWarning" IsOpen="False" IsClosable="False" Severity="Warning" Title="{loc:Tr Key=Components__CoreWarning__Title}"
                                             Message="{loc:Tr Key=Components__CoreWarning__Message}"/>
                                    <TextBlock x:Name="CoreConsentStatus" Visibility="Collapsed" Text="{loc:Tr Key=Components__CoreConsent__Pending}" Style="{StaticResource Secondary}"/>
                                    <TextBlock x:Name="SelectionCount" Style="{StaticResource Secondary}"/>
                                </StackPanel>
                            </Border>
                            <StackPanel x:Name="CustomChoices" Visibility="Collapsed" Spacing="18">
                            <ToggleSwitch x:Name="CustomCoreCheck" Header="{loc:Tr Key=Components__CustomCore__Header}" OffContent="{loc:Tr Key=Components__CustomCore__Off}" OnContent="{loc:Tr Key=Components__CustomCore__On}" Toggled="OnCustomCoreChanged"/>
                            <TextBlock Text="{loc:Tr Key=Components__GroupsHelp}"
                                       Style="{StaticResource Secondary}"/>
                            <ComboBox x:Name="OptionFilter" Header="{loc:Tr Key=Components__Filter__Header}" SelectedIndex="0" SelectionChanged="OnOptionFilterChanged" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="{loc:Tr Key=Common__All}"/><ComboBoxItem Content="{loc:Tr Key=Catalog__Category__Apps}"/><ComboBoxItem Content="{loc:Tr Key=Catalog__Category__Features}"/>
                                <ComboBoxItem Content="{loc:Tr Key=Catalog__Category__Settings}"/><ComboBoxItem Content="{loc:Tr Key=Catalog__Category__Advanced}"/>
                            </ComboBox>
                            <ItemsControl x:Name="OptionsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,8">
                                            <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                      AutomationProperties.Name="{Binding Title}" AutomationProperties.FullDescription="{Binding Description}">
                                                <StackPanel Spacing="5" Margin="6,0,0,0">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Secondary}" FontSize="12"/>
                                                </StackPanel>
                                            </CheckBox>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Style="{StaticResource Card}">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="{loc:Tr Key=Components__Advanced__Title}" Style="{StaticResource Section}"/>
                                    <TextBlock Text="{loc:Tr Key=Components__Advanced__Lead}"
                                               Style="{StaticResource Secondary}"/>
                                    <Button Content="{loc:Tr Key=Components__Advanced__ListAll}" Click="OnOpenExpert" HorizontalAlignment="Left"/>
                                    <StackPanel x:Name="ExpertPanel" Visibility="Collapsed" Spacing="12">
                                        <InfoBar IsOpen="True" IsClosable="False" Severity="Warning" Title="{loc:Tr Key=Components__Advanced__WarningTitle}"
                                                 Message="{loc:Tr Key=Components__Advanced__WarningMessage}"/>
                                        <CheckBox x:Name="ExpertConsent" Content="{loc:Tr Key=Components__Advanced__Consent}" Checked="OnChoicesChanged" Unchecked="OnChoicesChanged"/>
                                        <TextBox x:Name="InventorySearch" PlaceholderText="{loc:Tr Key=Common__SearchComponents}" TextChanged="OnInventoryFilterChanged"
                                                 AutomationProperties.Name="{loc:Tr Key=Common__SearchComponents}"/>
                                        <ComboBox x:Name="InventoryFilter" SelectedIndex="0" SelectionChanged="OnInventoryFilterSelection" HorizontalAlignment="Stretch"
                                                  AutomationProperties.Name="{loc:Tr Key=Common__ComponentType}">
                                            <ComboBoxItem Content="{loc:Tr Key=Common__All}"/><ComboBoxItem Content="ProvisionedApp"/><ComboBoxItem Content="SystemApp"/>
                                            <ComboBoxItem Content="Feature"/><ComboBoxItem Content="Capability"/><ComboBoxItem Content="Package"/>
                                            <ComboBoxItem Content="Service"/><ComboBoxItem Content="ComponentPayload"/>
                                        </ComboBox>
                                        <TextBlock x:Name="ExpertCount" Style="{StaticResource Secondary}"/>
                                        <TextBlock Text="{loc:Tr Key=Components__Advanced__IndividualHelp}"
                                                   Style="{StaticResource Secondary}" FontSize="12"/>
                                        <ListView x:Name="InventoryList" Height="420" SelectionMode="None" AutomationProperties.Name="{loc:Tr Key=Common__ImageComponents}">
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnSpacing="12" Padding="0,8">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                                                        <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch"
                                                                  AutomationProperties.Name="{Binding Title}" AutomationProperties.FullDescription="{Binding Detail}">
                                                            <StackPanel Spacing="4" Margin="6,0,0,0">
                                                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold"/>
                                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Secondary}" FontSize="11"/>
                                                                <TextBlock Text="{Binding Risk}" Foreground="{ThemeResource SystemFillColorCautionBrush}" FontSize="11"/>
                                                            </StackPanel>
                                                        </CheckBox>
                                                        <ComboBox Grid.Column="1" ItemsSource="{Binding Modes}" SelectedIndex="{Binding ModeIndex, Mode=TwoWay}"
                                                                  Visibility="{Binding HasModes, Converter={StaticResource BoolToVisibility}}" VerticalAlignment="Center"
                                                                  AutomationProperties.Name="{Binding ModeLabel}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                        <Button Content="{loc:Tr Key=Components__Advanced__Clear}" Click="OnClearExpert" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel x:Name="SettingsPanel" Visibility="Collapsed" Spacing="20">
                            <TextBlock Text="{loc:Tr Key=Settings__Heading}" Style="{StaticResource PageHeading}"/>
                            <TextBlock Text="{loc:Tr Key=Settings__Lead}"
                                       Style="{StaticResource Secondary}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel Spacing="14">
                                    <StackPanel Orientation="Horizontal" Spacing="16"><FontIcon Glyph="&#xE8B7;" FontSize="32"/><TextBlock Text="{loc:Tr Key=Settings__Files__Title}" FontSize="22" FontWeight="SemiBold"/></StackPanel>
                                    <TextBox x:Name="WorkspaceBox" Header="{loc:Tr Key=Settings__Workspace__Header}"/>
                                    <Button Content="{loc:Tr Key=Settings__Workspace__Choose}" Click="OnChooseWorkspace" HorizontalAlignment="Left"/>
                                    <TextBox x:Name="OutputBox" Header="{loc:Tr Key=Settings__Output__Header}"/>
                                    <Button Content="{loc:Tr Key=Settings__Output__Choose}" Click="OnChooseOutput" HorizontalAlignment="Left"/>
                                    <ComboBox x:Name="CompressionChoice" Header="{loc:Tr Key=Settings__Compression__Header}" SelectedIndex="0" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="{loc:Tr Key=Settings__Compression__Recovery}"/>
                                        <ComboBoxItem Content="{loc:Tr Key=Settings__Compression__Maximum}"/>
                                        <ComboBoxItem Content="{loc:Tr Key=Settings__Compression__Fast}"/>
                                    </ComboBox>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <Grid ColumnSpacing="20">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE945;" FontSize="36" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                    <StackPanel Grid.Column="1" Spacing="6">
                                        <TextBlock Text="{loc:Tr Key=Settings__Turbo__Title}" FontSize="18" FontWeight="SemiBold"/>
                                        <TextBlock Text="{loc:Tr Key=Settings__Turbo__Description}" Style="{StaticResource Secondary}"/>
                                    </StackPanel>
                                    <ToggleSwitch x:Name="TurboCheck" Grid.Column="2" OffContent="{loc:Tr Key=Common__Off}" OnContent="{loc:Tr Key=Common__On}" AutomationProperties.Name="{loc:Tr Key=Settings__Turbo__Title}"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <Grid ColumnSpacing="20">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE74D;" FontSize="36" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                    <StackPanel Grid.Column="1" Spacing="6">
                                        <TextBlock Text="{loc:Tr Key=Settings__Redundant__Title}" FontSize="18" FontWeight="SemiBold"/>
                                        <TextBlock Text="{loc:Tr Key=Settings__Redundant__Description}" Style="{StaticResource Secondary}"/>
                                    </StackPanel>
                                    <ToggleSwitch x:Name="RedundantDataCheck" Grid.Column="2" OffContent="{loc:Tr Key=Common__Keep}" OnContent="{loc:Tr Key=Common__Remove}" AutomationProperties.Name="{loc:Tr Key=Settings__Redundant__Title}"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <Grid ColumnSpacing="20">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE8B7;" FontSize="36" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                    <StackPanel Grid.Column="1" Spacing="6">
                                        <TextBlock Text="{loc:Tr Key=Settings__OmitSetup__Title}" FontSize="18" FontWeight="SemiBold"/>
                                        <TextBlock Text="{loc:Tr Key=Settings__OmitSetup__Description}" Style="{StaticResource Secondary}"/>
                                    </StackPanel>
                                    <ToggleSwitch x:Name="OmitSetupCheck" Grid.Column="2" OffContent="{loc:Tr Key=Common__Keep}" OnContent="{loc:Tr Key=Common__Omit}" AutomationProperties.Name="{loc:Tr Key=Settings__OmitSetup__Title}"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE8B9;" FontSize="36" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                    <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="{loc:Tr Key=Settings__Compact__Title}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{loc:Tr Key=Settings__Compact__Description}" Style="{StaticResource Secondary}"/></StackPanel>
                                    <ToggleSwitch x:Name="CompactCheck" Grid.Column="2" IsOn="True" OffContent="{loc:Tr Key=Common__Off}" OnContent="{loc:Tr Key=Common__On}" AutomationProperties.Name="{loc:Tr Key=Settings__Compact__Title}"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE943;" FontSize="36" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                    <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="{loc:Tr Key=Settings__NetFx__Title}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{loc:Tr Key=Settings__NetFx__Description}" Style="{StaticResource Secondary}"/></StackPanel>
                                    <ToggleSwitch x:Name="NetFxCheck" Grid.Column="2" OffContent="{loc:Tr Key=Common__Off}" OnContent="{loc:Tr Key=Common__On}" AutomationProperties.Name="{loc:Tr Key=Settings__NetFx__Title}"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE77B;" FontSize="36" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                    <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="{loc:Tr Key=Settings__LocalAccount__Title}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{loc:Tr Key=Settings__LocalAccount__Description}" Style="{StaticResource Secondary}"/></StackPanel>
                                    <ToggleSwitch x:Name="LocalAccountCheck" Grid.Column="2" OffContent="{loc:Tr Key=Common__Off}" OnContent="{loc:Tr Key=Common__On}" AutomationProperties.Name="{loc:Tr Key=Settings__LocalAccount__Title}"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE8B7;" FontSize="36" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                    <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="{loc:Tr Key=Settings__KeepFiles__Title}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{loc:Tr Key=Settings__KeepFiles__Description}" Style="{StaticResource Secondary}"/></StackPanel>
                                    <ToggleSwitch x:Name="KeepFilesCheck" Grid.Column="2" OffContent="{loc:Tr Key=Common__Off}" OnContent="{loc:Tr Key=Common__On}" AutomationProperties.Name="{loc:Tr Key=Settings__KeepFiles__Title}"/>
                                </Grid>
                            </Border>
                            <TextBlock x:Name="ToolStatus" Text="{loc:Tr Key=Settings__Tools__Initial}" Style="{StaticResource Secondary}"/>
                        </StackPanel>
                        <StackPanel x:Name="ReviewPanel" Visibility="Collapsed" Spacing="20">
                            <TextBlock Text="{loc:Tr Key=Review__Heading}" Style="{StaticResource PageHeading}"/>
                            <TextBlock Text="{loc:Tr Key=Review__Lead}" Style="{StaticResource Secondary}"/>
                            <Grid x:Name="ReviewCards" ColumnSpacing="16" RowSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="0"/><RowDefinition Height="0"/></Grid.RowDefinitions>
                                <Border x:Name="ReviewImageCard" Style="{StaticResource Card}"><StackPanel Spacing="12"><FontIcon Glyph="&#xE7F4;" FontSize="40" HorizontalAlignment="Left" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/><TextBlock Text="{loc:Tr Key=Review__Image__Title}" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="ReviewImage" Style="{StaticResource Secondary}"/></StackPanel></Border>
                                <Border x:Name="ReviewModeCard" Grid.Column="1" Style="{StaticResource Card}"><StackPanel Spacing="12"><FontIcon Glyph="&#xE713;" FontSize="40" HorizontalAlignment="Left" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/><TextBlock x:Name="ReviewMode" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="ReviewRemovals" Style="{StaticResource Secondary}"/></StackPanel></Border>
                                <Border x:Name="ReviewPathsCard" Grid.Row="1" Style="{StaticResource Card}"><StackPanel Spacing="12"><FontIcon Glyph="&#xE8B7;" FontSize="40" HorizontalAlignment="Left" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/><TextBlock Text="{loc:Tr Key=Review__Paths__Title}" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="ReviewPaths" Style="{StaticResource Secondary}" IsTextSelectionEnabled="True"/></StackPanel></Border>
                                <Border x:Name="ReviewOptionsCard" Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}"><StackPanel Spacing="12"><FontIcon Glyph="&#xE8B9;" FontSize="40" HorizontalAlignment="Left" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/><TextBlock Text="{loc:Tr Key=Review__Options__Title}" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="ReviewOptions" Style="{StaticResource Secondary}"/></StackPanel></Border>
                            </Grid>
                            <Border Style="{StaticResource Card}">
                                <Expander Header="{loc:Tr Key=Review__Details__Header}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                    <TextBox x:Name="ReviewText" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" FontSize="13"/>
                                </Expander>
                            </Border>
                            <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="{loc:Tr Key=Review__Warning__Title}"
                                     Message="{loc:Tr Key=Review__Warning__Message}"/>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button Content="{loc:Tr Key=Review__SaveRecipe}" Click="OnSaveRecipe"/>
                                <Button Content="{loc:Tr Key=Review__LoadRecipe}" Click="OnLoadRecipe"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel x:Name="BuildPanel" Visibility="Collapsed" Spacing="32">
                            <StackPanel Spacing="12">
                                <TextBlock x:Name="BuildHeading" Text="{loc:Tr Key=Build__Heading}" Style="{StaticResource PageHeading}"/>
                                <TextBlock x:Name="BuildDescription" Text="{loc:Tr Key=Build__Description}"
                                           Style="{StaticResource Secondary}" FontSize="16"/>
                            </StackPanel>
                            <Border Style="{StaticResource Card}" Padding="32">
                                <StackPanel Spacing="32">
                                    <Grid ColumnSpacing="24">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Grid Width="64" Height="64" VerticalAlignment="Center">
                                            <ProgressRing x:Name="BuildActivity" IsActive="False" Width="64" Height="64" AutomationProperties.Name="{loc:Tr Key=Common__BuildActivity}"/>
                                            <FontIcon x:Name="BuildGlyph" Glyph="&#xE7C5;" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                        </Grid>
                                        <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock x:Name="CurrentStage" Text="{loc:Tr Key=Build__Waiting}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock x:Name="CurrentMessage" Style="{StaticResource Secondary}" Text="{loc:Tr Key=Build__NoChanges}"/>
                                        </StackPanel>
                                        <TextBlock x:Name="BuildPercent" Grid.Column="2" Text="0%" FontSize="48" FontWeight="Light" VerticalAlignment="Center"/>
                                    </Grid>
                                    <StackPanel Spacing="12">
                                        <Grid ColumnSpacing="16">
                                            <TextBlock Text="{loc:Tr Key=Build__Overall}" Style="{StaticResource FieldLabel}"/>
                                            <TextBlock x:Name="OverallStep" HorizontalAlignment="Right" Style="{StaticResource Hint}"/>
                                        </Grid>
                                        <ProgressBar x:Name="OverallBar" Minimum="0" Maximum="100" MinHeight="10" AutomationProperties.Name="{loc:Tr Key=Common__OverallProgress}">
                                            <ProgressBar.Resources><x:Double x:Key="ProgressBarTrackHeight">10</x:Double></ProgressBar.Resources>
                                        </ProgressBar>
                                    </StackPanel>
                                    <StackPanel Spacing="12">
                                        <Grid ColumnSpacing="16">
                                            <TextBlock Text="{loc:Tr Key=Build__CurrentOperation}" Style="{StaticResource Secondary}" FontSize="14"/>
                                            <TextBlock x:Name="CurrentPercent" HorizontalAlignment="Right" Style="{StaticResource Hint}"/>
                                        </Grid>
                                        <ProgressBar x:Name="BuildBar" Minimum="0" Maximum="100" AutomationProperties.Name="{loc:Tr Key=Common__CurrentOperationProgress}"/>
                                    </StackPanel>
                                    <TextBlock x:Name="CancelHint" Visibility="Collapsed" Style="{StaticResource Hint}"
                                               Text="{loc:Tr Key=Build__CancelHint}"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="ResultPanel" Style="{StaticResource Card}" Padding="32" Visibility="Collapsed">
                                <StackPanel Spacing="24">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE73E;" FontSize="32" VerticalAlignment="Top" Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                                        <StackPanel Grid.Column="1" Spacing="8">
                                            <TextBlock Text="{loc:Tr Key=Build__IsoCreated}" Style="{StaticResource SectionTitle}"/>
                                            <TextBlock x:Name="ResultMetrics" Style="{StaticResource Secondary}"/>
                                        </StackPanel>
                                    </Grid>
                                    <InfoBar x:Name="ResultWarnings" IsOpen="False" IsClosable="False" Severity="Warning" Title="{loc:Tr Key=Build__FinishedWithWarnings}"/>
                                    <StackPanel Spacing="16">
                                        <TextBox x:Name="ResultPath" Header="{loc:Tr Key=Build__OutputIso}" IsReadOnly="True"/>
                                        <TextBox x:Name="ResultHash" Header="{loc:Tr Key=Build__Sha256}" IsReadOnly="True" FontFamily="Consolas"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Button Content="{loc:Tr Key=Build__OpenOutputFolder}" Click="OnOpenOutputFolder"/>
                                        <Button Content="{loc:Tr Key=Build__OpenLogsAndReport}" Click="OnOpenLogs"/>
                                    </StackPanel>
                                    <TextBlock Text="{loc:Tr Key=Build__TestIso}" Style="{StaticResource Hint}"/>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{loc:Tr Key=Build__SupportPrompt}" Style="{StaticResource Hint}"/>
                                        <HyperlinkButton Content="{loc:Tr Key=Support__Development}" Click="OnSupport" Padding="0"
                                                         AutomationProperties.HelpText="{loc:Tr Key=Support__Development__Help__Short}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <StackPanel Spacing="16">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{loc:Tr Key=Build__History}" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock x:Name="HistoryCount" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource Secondary}" Text="{loc:Tr Key=Build__Stages__Initial}"/>
                                </Grid>
                                <TextBlock Text="{loc:Tr Key=Build__ExpandStage}" Style="{StaticResource Hint}"/>
                                <ItemsControl x:Name="BuildStages">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="12"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                  IsExpanded="{Binding Expanded, Mode=TwoWay}" AutomationProperties.Name="{Binding AutomationName}">
                                            <Expander.Header>
                                                <Grid ColumnSpacing="16" HorizontalAlignment="Stretch" MinHeight="56">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <FontIcon Glyph="{Binding Glyph}" FontSize="24" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Status}" Style="{StaticResource Secondary}" FontSize="13" VerticalAlignment="Center" TextAlignment="Right" MaxWidth="260"/>
                                                </Grid>
                                            </Expander.Header>
                                            <ListView ItemsSource="{Binding Operations}" SelectionMode="None" MaxHeight="360">
                                                <ListView.ItemTemplate><DataTemplate>
                                                    <Grid ColumnSpacing="16" Padding="0,10" AutomationProperties.Name="{Binding AutomationName}">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <Grid Width="20" Height="20" VerticalAlignment="Top" Margin="0,2,0,0">
                                                            <FontIcon Glyph="{Binding Glyph}" FontSize="16" Opacity="0.65"
                                                                      Visibility="{Binding State, Converter={StaticResource StateVisibility}, ConverterParameter='Pending|Skipped'}"/>
                                                            <FontIcon Glyph="&#xE73E;" FontSize="16" Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                                      Visibility="{Binding State, Converter={StaticResource StateVisibility}, ConverterParameter='Completed'}"/>
                                                            <FontIcon Glyph="&#xE895;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                                      Visibility="{Binding State, Converter={StaticResource StateVisibility}, ConverterParameter='Running'}"/>
                                                            <FontIcon Glyph="&#xE711;" FontSize="16" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                                      Visibility="{Binding State, Converter={StaticResource StateVisibility}, ConverterParameter='Failed'}"/>
                                                            <FontIcon Glyph="&#xE711;" FontSize="16" Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                                      Visibility="{Binding State, Converter={StaticResource StateVisibility}, ConverterParameter='Cancelled'}"/>
                                                        </Grid>
                                                        <StackPanel Grid.Column="1" Spacing="6">
                                                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding Detail}" Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}" Style="{StaticResource Secondary}" FontSize="12" IsTextSelectionEnabled="True"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Text="{Binding Status}" Style="{StaticResource Secondary}" FontSize="12" VerticalAlignment="Top" Margin="0,3,0,0"/>
                                                    </Grid>
                                                </DataTemplate></ListView.ItemTemplate>
                                            </ListView>
                                        </Expander>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <Expander x:Name="BuildDetails" Header="{loc:Tr Key=Build__Details}" IsExpanded="False" Expanding="OnDetailsExpanding"
                                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <TextBox x:Name="BuildLog" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                         Height="300" FontFamily="Consolas" FontSize="11" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         SelectionChanged="OnLogSelectionChanged" AutomationProperties.Name="{loc:Tr Key=Common__BuildLog}"/>
                            </Expander>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
                <TextBlock x:Name="StepNumber" Grid.Row="2" Text="1" FontSize="112" FontWeight="Light"
                           Opacity="0.10" Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                           HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,28,0"
                           IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw"/>
                <Grid x:Name="ActionArea" Grid.Row="3" Padding="32,8,32,24" ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Button x:Name="ResumeRunButton" Visibility="Collapsed" Content="{loc:Tr Key=Action__ResumeBuild}" Click="OnResumeStopped"
                                AutomationProperties.HelpText="{loc:Tr Key=Action__ResumeBuild__Help__Stopped}"/>
                    </StackPanel>
                    <Button Grid.Column="2" x:Name="NextButton" MinWidth="140" Click="OnNext" Background="Transparent" BorderThickness="0" Padding="8,4">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <TextBlock x:Name="ActionLabel" Text="{loc:Tr Key=Common__Start}" FontSize="32" FontWeight="Light" Opacity="{ThemeResource ActionLabelOpacity}"/>
                            <FontIcon x:Name="ActionArrow" Glyph="&#xE72A;" FontSize="24" Opacity="{ThemeResource ActionArrowOpacity}"/>
                        </StackPanel>
                    </Button>
                </Grid>
                </Grid>
                <!-- Drawn over the pane so showing it never moves the page. -->
                <ProgressBar x:Name="BusyBar" IsIndeterminate="True" VerticalAlignment="Top" Margin="16,0,0,0" IsHitTestVisible="False"
                             Visibility="Collapsed" AutomationProperties.Name="{loc:Tr Key=Common__Working}"/>
            </Grid>
        </Grid>
        <ContentDialog x:Name="SupportDialog" Title="{loc:Tr Key=Support__Title}" CloseButtonText="{loc:Tr Key=Common__Close}"
                       DefaultButton="Close">
            <StackPanel Spacing="20" MaxWidth="440">
                <TextBlock x:Name="SupportPurpose" TextWrapping="Wrap"/>
                <StackPanel Spacing="8">
                    <TextBlock Text="{loc:Tr Key=Support__Monthly}" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="{loc:Tr Key=Support__Monthly__Description}" Style="{StaticResource Secondary}"/>
                    <HyperlinkButton x:Name="SponsorsLink" Content="{loc:Tr Key=Support__Monthly__Link}" Click="OnSupportDestination" Tag="Sponsors" Padding="0"/>
                </StackPanel>
                <StackPanel Spacing="8">
                    <TextBlock Text="{loc:Tr Key=Support__OneTime}" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="{loc:Tr Key=Support__OneTime__Description}" Style="{StaticResource Secondary}"/>
                    <HyperlinkButton x:Name="KofiLink" Content="{loc:Tr Key=Support__OneTime__Link}" Click="OnSupportDestination" Tag="Kofi" Padding="0"/>
                </StackPanel>
                <StackPanel Spacing="8">
                    <TextBlock Text="{loc:Tr Key=Support__Other}" Style="{StaticResource Hint}"/>
                    <StackPanel Orientation="Horizontal" Spacing="20">
                        <HyperlinkButton Content="{loc:Tr Key=Support__Patreon}" Click="OnSupportDestination" Tag="Patreon" Padding="0"/>
                        <HyperlinkButton Content="{loc:Tr Key=Support__PayPal}" Click="OnSupportDestination" Tag="PayPal" Padding="0"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="{loc:Tr Key=Support__LinksNote}" Style="{StaticResource Hint}"/>
                <InfoBar x:Name="SupportError" IsOpen="False" IsClosable="True" Severity="Error"/>
            </StackPanel>
        </ContentDialog>
    </Grid>
</Window>
