                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Button Content="Open output folder" Click="OnOpenOutputFolder" local:Translation.Properties="Content=Text.OpenOutputFolder"/>
                                        <Button Content="Open logs and report" Click="OnOpenLogs" local:Translation.Properties="Content=Text.OpenLogsAndReport"/>
                                    </StackPanel>
                                    <TextBlock Text="Test the ISO in a VM before installing Windows." Style="{StaticResource Hint}" local:Translation.Properties="Text=Text.TestTheISOInAVMBeforeInstallingWindows"/>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="If Tiny11 Builder saved you time, you can support its development." Style="{StaticResource Hint}" local:Translation.Properties="Text=Text.IfTiny11BuilderSavedYouTimeYouCanSupport"/>
                                        <HyperlinkButton Content="Support development" Click="OnSupport" Padding="0"
                                                         AutomationProperties.HelpText="Optional support. Opens support choices, not a payment." local:Translation.Properties="Content=Text.SupportDevelopment;AutomationProperties.HelpText=Text.OptionalSupportOpensSupportChoicesNotAPayment"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <StackPanel Spacing="16">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Operation history" Style="{StaticResource SectionTitle}" local:Translation.Properties="Text=Text.OperationHistory"/>
                                    <TextBlock x:Name="HistoryCount" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource Secondary}" Text="0 of 7 stages done" local:Translation.Properties="Text=Text.0Of7StagesDone"/>
                                </Grid>
                                <TextBlock Text="Expand a stage to see each step and any error details." Style="{StaticResource Hint}" local:Translation.Properties="Text=Text.ExpandAStageToSeeEachStepAndAny"/>
                                <ItemsControl x:Name="BuildStages">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="12"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                  IsExpanded="{Binding Expanded, Mode=TwoWay}" AutomationProperties.Name="{Binding AutomationName}">
                                            <Expander.Header>
                                                <Grid ColumnSpacing="16" HorizontalAlignment="Stretch" MinHeight="56">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <FontIcon Glyph="{Binding Glyph}" FontSize="24" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Status}" Style="{StaticResource Secondary}" FontSize="13" VerticalAlignment="Center" TextAlignment="Right" MaxWidth="260"/>
                                                </Grid>
                                            </Expander.Header>
                                            <ListView ItemsSource="{Binding Operations}" SelectionMode="None" MaxHeight="360">
                                                <ListView.ItemTemplate><DataTemplate>
                                                    <Grid ColumnSpacing="16" Padding="0,10" AutomationProperties.Name="{Binding AutomationName}">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <Grid Width="20" Height="20" VerticalAlignment="Top" Margin="0,2,0,0">
                                                            <FontIcon Glyph="{Binding Glyph}" FontSize="16" Opacity="0.65"
                                                                      Visibility="{Binding State, Converter={StaticResource StateVisibility}, ConverterParameter='Pending|Skipped'}"/>
                                                            <FontIcon Glyph="&#xE73E;" FontSize="16" Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                                      Visibility="{Binding State, Converter={StaticResource StateVisibility}, ConverterParameter='Completed'}"/>
                                                            <FontIcon Glyph="&#xE895;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                                      Visibility="{Binding State, Converter={StaticResource StateVisibility}, ConverterParameter='Running'}"/>
                                                            <FontIcon Glyph="&#xE711;" FontSize="16" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                                      Visibility="{Binding State, Converter={StaticResource StateVisibility}, ConverterParameter='Failed'}"/>
                                                            <FontIcon Glyph="&#xE711;" FontSize="16" Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                                      Visibility="{Binding State, Converter={StaticResource StateVisibility}, ConverterParameter='Cancelled'}"/>
                                                        </Grid>
                                                        <StackPanel Grid.Column="1" Spacing="6">
                                                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding Detail}" Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}" Style="{StaticResource Secondary}" FontSize="12" IsTextSelectionEnabled="True"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Text="{Binding Status}" Style="{StaticResource Secondary}" FontSize="12" VerticalAlignment="Top" Margin="0,3,0,0"/>
                                                    </Grid>
                                                </DataTemplate></ListView.ItemTemplate>
                                            </ListView>
                                        </Expander>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <TextBlock Text="Interface labels follow your chosen language. Image names, component identifiers, Windows tool output and detailed diagnostic logs may remain in English."
                                       Style="{StaticResource Hint}" local:Translation.Properties="Text=Text.InterfaceLabelsFollowYourChosenLanguageImageNamesComponent"/>
                            <Expander x:Name="BuildDetails" Header="Build details" IsExpanded="False" Expanding="OnDetailsExpanding"
                                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" local:Translation.Properties="Header=Text.BuildDetails;AutomationProperties.Name=Text.BuildDetails">
                                <TextBox x:Name="BuildLog" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                         Height="300" FontFamily="Consolas" FontSize="11" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         SelectionChanged="OnLogSelectionChanged" AutomationProperties.Name="Build log" local:Translation.Properties="AutomationProperties.Name=Text.BuildLog"/>
                            </Expander>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
                <TextBlock x:Name="StepNumber" Grid.Row="2" Text="1" FontSize="112" FontWeight="Light"
                           Opacity="0.10" Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                           HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,28,0"
                           IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw"/>
                <Grid x:Name="ActionArea" Grid.Row="3" Padding="32,8,32,24" ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="NavigationHint" Grid.Column="0" Style="{StaticResource Hint}" VerticalAlignment="Center" Visibility="Collapsed"
                               AutomationProperties.LiveSetting="Polite"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Button x:Name="ResumeRunButton" Visibility="Collapsed" Content="Resume build" Click="OnResumeStopped"
                                AutomationProperties.HelpText="Continue this build from the progress it saved." local:Translation.Properties="Content=Text.ResumeBuild;AutomationProperties.HelpText=Text.ContinueThisBuildFromTheProgressItSaved"/>
                    </StackPanel>
                    <Button Grid.Column="2" x:Name="NextButton" MinWidth="140" Click="OnNext" Background="Transparent" BorderThickness="0" Padding="8,4">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <TextBlock x:Name="ActionLabel" Text="Start" FontSize="32" FontWeight="Light" Opacity="{ThemeResource ActionLabelOpacity}" local:Translation.Properties="Text=Text.Start"/>
                            <FontIcon x:Name="ActionArrow" Glyph="&#xE72A;" FontSize="24" Opacity="{ThemeResource ActionArrowOpacity}"/>
                        </StackPanel>
                    </Button>
                </Grid>
                </Grid>
                <!-- Drawn over the pane so showing it never moves the page. -->
                <ProgressBar x:Name="BusyBar" IsIndeterminate="True" VerticalAlignment="Top" Margin="16,0,0,0" IsHitTestVisible="False"
                             Visibility="Collapsed" AutomationProperties.Name="Working" local:Translation.Properties="AutomationProperties.Name=Text.Working"/>
            </Grid>
        </Grid>
        <ContentDialog x:Name="CustomEntryDialog" Title="Custom image" PrimaryButtonText="Choose manually"
                       SecondaryButtonText="Load recipe…" CloseButtonText="Cancel" DefaultButton="Close"
                       local:Translation.Properties="Title=CustomEntry.Title;PrimaryButtonText=CustomEntry.Manual;SecondaryButtonText=CustomEntry.Load;CloseButtonText=Common.Cancel">
            <TextBlock Text="Choose your own removals, or load a saved JSON recipe. You will still inspect the source image and review the settings before building."
                       TextWrapping="Wrap" MaxWidth="440" local:Translation.Properties="Text=CustomEntry.Description"/>
        </ContentDialog>
        <ContentDialog x:Name="SupportDialog" Title="Support Tiny11 Builder" CloseButtonText="Close"
                       DefaultButton="Close" local:Translation.Properties="Title=Text.SupportTiny11Builder;CloseButtonText=Text.Close">
            <StackPanel Spacing="20" MaxWidth="440">
                <TextBlock x:Name="SupportPurpose" TextWrapping="Wrap"/>
                <StackPanel Spacing="8">
                    <TextBlock Text="Monthly support" FontSize="18" FontWeight="SemiBold" local:Translation.Properties="Text=Text.MonthlySupport"/>
                    <TextBlock Text="Help keep the project maintained over time." Style="{StaticResource Secondary}" local:Translation.Properties="Text=Text.HelpKeepTheProjectMaintainedOverTime"/>
                    <HyperlinkButton x:Name="SponsorsLink" Content="Support monthly on GitHub Sponsors" Click="OnSupportDestination" Tag="Sponsors" Padding="0" local:Translation.Properties="Content=Text.SupportMonthlyOnGitHubSponsors"/>
                </StackPanel>
                <StackPanel Spacing="8">
                    <TextBlock Text="One-time donation" FontSize="18" FontWeight="SemiBold" local:Translation.Properties="Text=Text.OneTimeDonation"/>
                    <TextBlock Text="A one-off thank-you, with no commitment." Style="{StaticResource Secondary}" local:Translation.Properties="Text=Text.AOneOffThankYouWithNoCommitment"/>
                    <HyperlinkButton x:Name="KofiLink" Content="Donate once on Ko-fi" Click="OnSupportDestination" Tag="Kofi" Padding="0" local:Translation.Properties="Content=Text.DonateOnceOnKoFi"/>
                </StackPanel>
                <StackPanel Spacing="8">
                    <TextBlock Text="Prefer another service?" Style="{StaticResource Hint}" local:Translation.Properties="Text=Text.PreferAnotherService"/>
                    <StackPanel Orientation="Horizontal" Spacing="20">
                        <HyperlinkButton Content="Patreon" Click="OnSupportDestination" Tag="Patreon" Padding="0"/>
                        <HyperlinkButton Content="PayPal" Click="OnSupportDestination" Tag="PayPal" Padding="0"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="Links open in your browser. Nothing is charged or subscribed to in the app." Style="{StaticResource Hint}" local:Translation.Properties="Text=Text.LinksOpenInYourBrowserNothingIsChargedOr"/>
                <InfoBar x:Name="SupportError" IsOpen="False" IsClosable="True" Severity="Error"/>
            </StackPanel>
        </ContentDialog>
    </Grid>
</Window>
