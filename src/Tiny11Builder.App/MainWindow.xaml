<Window
    x:Class="Tiny11Builder.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:local="using:Tiny11Builder.App"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Tiny11 Builder">
    <Window.SystemBackdrop><MicaBackdrop Kind="BaseAlt"/></Window.SystemBackdrop>
    <Grid x:Name="Root">
        <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid x:Name="TitleArea" Padding="24,0,140,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE7F8;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
            <TextBlock Grid.Column="1" Text="Tiny11 Builder" VerticalAlignment="Center" FontWeight="SemiBold"/>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="248"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ScrollViewer x:Name="SidebarScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          HorizontalScrollMode="Disabled" HorizontalContentAlignment="Stretch">
                <Grid Padding="16,24,16,20" MinHeight="{Binding ElementName=SidebarScroller, Path=ViewportHeight}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Spacing="8">
                        <TextBlock Text="BUILD STEPS" FontSize="10" CharacterSpacing="160"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" Margin="14,0,0,18" local:Translation.Properties="Text=Text.BUILDSTEPS"/>
                        <ListView x:Name="StepRail" SelectionChanged="OnRailChanged">
                            <ListViewItem Tag="0"><StackPanel Orientation="Horizontal" Spacing="14"><TextBlock Text="1" FontFamily="Consolas"/><TextBlock Text="Welcome" local:Translation.Properties="Text=Text.Welcome"/></StackPanel></ListViewItem>
                            <ListViewItem Tag="1"><StackPanel Orientation="Horizontal" Spacing="14"><TextBlock Text="2" FontFamily="Consolas"/><TextBlock Text="Windows image" local:Translation.Properties="Text=Text.WindowsImage"/></StackPanel></ListViewItem>
                            <ListViewItem Tag="2"><StackPanel Orientation="Horizontal" Spacing="14"><TextBlock Text="3" FontFamily="Consolas"/><TextBlock Text="Remove components" local:Translation.Properties="Text=Text.RemoveComponents"/></StackPanel></ListViewItem>
                            <ListViewItem Tag="3"><StackPanel Orientation="Horizontal" Spacing="14"><TextBlock Text="4" FontFamily="Consolas"/><TextBlock Text="Build settings" local:Translation.Properties="Text=Text.BuildSettings"/></StackPanel></ListViewItem>
                            <ListViewItem Tag="4"><StackPanel Orientation="Horizontal" Spacing="14"><TextBlock Text="5" FontFamily="Consolas"/><TextBlock Text="Review" local:Translation.Properties="Text=Text.Review"/></StackPanel></ListViewItem>
                            <ListViewItem Tag="5"><StackPanel Orientation="Horizontal" Spacing="14"><TextBlock Text="6" FontFamily="Consolas"/><TextBlock Text="Create image" local:Translation.Properties="Text=Text.CreateImage"/></StackPanel></ListViewItem>
                        </ListView>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Spacing="12">
                        <Border Style="{StaticResource Card}" Padding="16">
                            <StackPanel Spacing="6">
                                <TextBlock Text="SELECTED IMAGE" FontSize="10" CharacterSpacing="120" local:Translation.Properties="Text=Text.SELECTEDIMAGE"/>
                                <TextBlock x:Name="ImageBadge" Text="No image selected" FontWeight="SemiBold" TextWrapping="Wrap" local:Translation.Properties="Text=Image.NoneSelected"/>
                                <TextBlock Text="Source files are not modified." FontSize="12" Style="{StaticResource Secondary}" local:Translation.Properties="Text=Text.SourceFilesAreNotModified"/>
                            </StackPanel>
                        </Border>
                        <Button x:Name="ResumeButton" Content="Resume build" Click="OnResume" HorizontalAlignment="Stretch"
                                AutomationProperties.HelpText="Continue a stopped build from the progress it saved." local:Translation.Properties="Content=Text.ResumeBuild;AutomationProperties.HelpText=Text.ContinueAStoppedBuildFromTheProgressItSaved"/>
                        <Button x:Name="RecoverButton" Content="Recover workspace" Click="OnRecover" HorizontalAlignment="Stretch" local:Translation.Properties="Content=Text.RecoverWorkspace"/>
                        <ComboBox x:Name="ThemeChoice" Header="Appearance" SelectionChanged="OnThemeChanged" HorizontalAlignment="Stretch" SelectedIndex="0" local:Translation.Properties="Header=Text.Appearance">
                            <ComboBoxItem Content="System" local:Translation.Properties="Content=Text.System"/><ComboBoxItem Content="Light" local:Translation.Properties="Content=Text.Light"/><ComboBoxItem Content="Dark" local:Translation.Properties="Content=Text.Dark"/>
                        </ComboBox>
                        <ComboBox x:Name="LanguageChoice" Header="Interface language" DisplayMemberPath="Name" SelectionChanged="OnLanguageChanged"
                                  HorizontalAlignment="Stretch" AutomationProperties.Name="Interface language"
                                  AutomationProperties.HelpText="Changes the app interface only, not the language of your Windows image. Missing translations use English." local:Translation.Properties="Header=Text.InterfaceLanguage;AutomationProperties.Name=Text.InterfaceLanguage;AutomationProperties.HelpText=Text.ChangesTheAppInterfaceOnlyNotTheLanguageOf"/>
                        <StackPanel Spacing="4">
                            <HyperlinkButton x:Name="SupportButton" Content="Support development" Click="OnSupport" Padding="0"
                                             AutomationProperties.HelpText="Optional monthly support or one-time donation. All app features remain free." local:Translation.Properties="Content=Text.SupportDevelopment;AutomationProperties.HelpText=Text.OptionalMonthlySupportOrOneTimeDonationAllApp"/>
                            <HyperlinkButton Content="Upstream project ↗" NavigateUri="https://github.com/ntdevlabs/tiny11builder" Padding="0" local:Translation.Properties="Content=Text.UpstreamProject"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
            <Grid Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="16,0,0,0"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,0">
                <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <!-- The fixed shell row: Back on the left, Cancel on the right, above the scrolling page and its watermark. -->
                <Grid x:Name="ShellRow" Padding="28,0,28,0" ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button x:Name="BackButton" Click="OnBack" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,12,0,0"
                            Background="Transparent" BorderThickness="0" Padding="12,8" AutomationProperties.Name="Back" local:Translation.Properties="AutomationProperties.Name=Text.Back">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE72B;" FontSize="16" Opacity="{ThemeResource SubtleIconOpacity}"/>
                                <TextBlock Text="Back" Foreground="{ThemeResource TextFillColorSecondaryBrush}" local:Translation.Properties="Text=Text.Back"/>
                            </StackPanel>
                        </Button.Content>
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Left" Modifiers="Menu"/>
                        </Button.KeyboardAccelerators>
                    </Button>
                    <TextBlock x:Name="BusyText" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,12,0,0" IsHitTestVisible="False"
                               Style="{StaticResource Secondary}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                               FontSize="12" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
                    <Button x:Name="CancelButton" Grid.Column="2" Style="{StaticResource CriticalButtonStyle}" Visibility="Collapsed" Click="OnCancel"
                            VerticalAlignment="Top" Margin="0,12,0,0" Padding="14,8" AutomationProperties.Name="Cancel safely" local:Translation.Properties="AutomationProperties.Name=Common.CancelSafely">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE711;" FontSize="14"/>
                            <TextBlock Text="Cancel safely" local:Translation.Properties="Text=Common.CancelSafely"/>
                        </StackPanel>
                    </Button>
                </Grid>
                <InfoBar x:Name="Notice" Grid.Row="1" IsOpen="False" IsClosable="True" Margin="32,12,32,0">
                    <InfoBar.ActionButton>
                        <Button x:Name="NoticeButton" Click="OnNoticeAction" Visibility="Collapsed"/>
                    </InfoBar.ActionButton>
                </InfoBar>
                <ScrollViewer x:Name="ContentScroller" Grid.Row="2" Padding="40,24,40,20" HorizontalScrollBarVisibility="Disabled"
                              SizeChanged="OnContentSizeChanged" ViewChanged="OnContentViewChanged">
                    <Grid HorizontalAlignment="Stretch">
                        <Grid x:Name="WelcomePanel" RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Spacing="8">
                                <TextBlock x:Name="WelcomeTitle" Text="Welcome" FontSize="56" FontWeight="Light" Opacity="{ThemeResource WelcomeTitleOpacity}"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="Wrap"
                                           AutomationProperties.HeadingLevel="Level1" local:Translation.Properties="Text=Text.Welcome"/>
                                <TextBlock Text="Create a customized Windows 11 ISO. Select an image, choose what to remove, and build the ISO."
                                           FontSize="16" Style="{StaticResource Secondary}" local:Translation.Properties="Text=Text.CreateACustomizedWindows11ISOSelectAnImage"/>
                            </StackPanel>
                            <Grid Grid.Row="1" RowSpacing="12">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <TextBlock Text="Build modes" FontSize="18" FontWeight="SemiBold" local:Translation.Properties="Text=Text.BuildModes"/>
                                <Grid x:Name="ModeCards" Grid.Row="1" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/><RowDefinition Height="0"/><RowDefinition Height="0"/>
                                    </Grid.RowDefinitions>
                                    <Button x:Name="RegularModeCard" Style="{StaticResource ModeCard}" Tag="Tiny11" Click="OnModeCardClick"
                                            AutomationProperties.Name="Tiny11" AutomationProperties.HelpText="Select Tiny11 and choose a Windows ISO." local:Translation.Properties="AutomationProperties.HelpText=Text.SelectTiny11AndChooseAWindowsISO">
                                        <Grid RowSpacing="12">
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <FontIcon Glyph="&#xE7F4;" FontSize="64" HorizontalAlignment="Left"
                                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                            <StackPanel Grid.Row="1" Spacing="10">
                                                <TextBlock Text="Tiny11" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Text="Use the original Tiny11 removals. Keep Windows Update and recovery."
                                                           Style="{StaticResource Secondary}" FontSize="13" local:Translation.Properties="Text=Text.UseTheOriginalTiny11RemovalsKeepWindowsUpdateAnd"/>
                                            </StackPanel>
                                            <TextBlock Grid.Row="2" Text="Update support retained" FontSize="12" TextWrapping="Wrap"
                                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" local:Translation.Properties="Text=Text.UpdateSupportRetained"/>
                                        </Grid>
                                    </Button>
                                    <Button x:Name="CoreModeCard" Grid.Column="1" Style="{StaticResource ModeCard}" Tag="Tiny11Core" Click="OnModeCardClick"
                                            AutomationProperties.Name="Tiny11 Core" AutomationProperties.HelpText="Select Tiny11 Core and choose a Windows ISO." local:Translation.Properties="AutomationProperties.HelpText=Text.SelectTiny11CoreAndChooseAWindowsISO">
                                        <Grid RowSpacing="12">
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <FontIcon Glyph="&#xE8B7;" FontSize="64" HorizontalAlignment="Left"
                                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                            <StackPanel Grid.Row="1" Spacing="10">
                                                <TextBlock Text="Tiny11 Core" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Text="Remove update and recovery support and disable Defender."
                                                           Style="{StaticResource Secondary}" FontSize="13" local:Translation.Properties="Text=Text.RemoveUpdateAndRecoverySupportAndDisableDefender"/>
                                            </StackPanel>
                                            <TextBlock Grid.Row="2" Text="For test VMs only" FontSize="12" TextWrapping="Wrap"
                                                       Foreground="{ThemeResource SystemFillColorCautionBrush}" local:Translation.Properties="Text=Text.ForTestVMsOnly"/>
                                        </Grid>
                                    </Button>
                                    <Button x:Name="CustomModeCard" Grid.Column="2" Style="{StaticResource ModeCard}" Tag="Custom" Click="OnModeCardClick"
                                            AutomationProperties.Name="Custom" AutomationProperties.HelpText="Select Custom and choose a Windows ISO." local:Translation.Properties="AutomationProperties.Name=Mode.Custom;AutomationProperties.HelpText=Text.SelectCustomAndChooseAWindowsISO">
                                        <Grid RowSpacing="12">
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <FontIcon Glyph="&#xE713;" FontSize="64" HorizontalAlignment="Left"
                                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                            <StackPanel Grid.Row="1" Spacing="10">
                                                <TextBlock Text="Custom" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" local:Translation.Properties="Text=Mode.Custom"/>
                                                <TextBlock Text="Select individual apps, components and services to remove."
                                                           Style="{StaticResource Secondary}" FontSize="13" local:Translation.Properties="Text=Text.SelectIndividualAppsComponentsAndServicesToRemove"/>
                                            </StackPanel>
                                            <TextBlock Grid.Row="2" Text="Protected items included" FontSize="12" TextWrapping="Wrap"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" local:Translation.Properties="Text=Text.ProtectedItemsIncluded"/>
                                        </Grid>
                                    </Button>
                                </Grid>
                            </Grid>
                            <Grid Grid.Row="2" Padding="0,16,0,0">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Windows 11 22H2 or newer · x64 and ARM64 · Insider / Canary" FontSize="13" TextWrapping="Wrap" local:Translation.Properties="Text=Text.Windows1122H2OrNewerX64AndARM64Insider"/>
                                    <TextBlock Text="Test Core and custom images in a VM before use."
                                               Style="{StaticResource Secondary}" FontSize="12" local:Translation.Properties="Text=Text.TestCoreAndCustomImagesInAVMBefore"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                        <StackPanel x:Name="SourcePanel" Visibility="Collapsed" Spacing="20">
                            <TextBlock Text="Windows image" Style="{StaticResource PageHeading}" local:Translation.Properties="Text=Text.WindowsImage"/>
                            <TextBlock x:Name="SourceMode" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontSize="13"/>
                            <TextBlock Text="Download the latest Windows 11 from Microsoft, or select an ISO or extracted installation folder. Inspect the image to select an edition."
                                       Style="{StaticResource Secondary}" local:Translation.Properties="Text=Text.DownloadTheLatestWindows11FromMicrosoftOrSelect"/>
                            <Grid x:Name="SourceCards" ColumnSpacing="16" RowSpacing="20">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="0"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Border x:Name="LocalMediaCard" Grid.Row="1" Style="{StaticResource Card}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Local installation media" Style="{StaticResource BodyStrongTextBlockStyle}" local:Translation.Properties="Text=Text.LocalInstallationMedia"/>
                                    <TextBox x:Name="SourcePathBox" Header="Windows ISO or installation-media folder" TextChanged="OnSourceChanged" PlaceholderText="Choose a Windows 11 image" local:Translation.Properties="Header=Text.WindowsISOOrInstallationMediaFolder;PlaceholderText=Text.ChooseAWindows11Image"/>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button Content="Choose ISO" Click="OnChooseIso" local:Translation.Properties="Content=Text.ChooseISO"/>
                                        <Button Content="Choose folder" Click="OnChooseSourceFolder" local:Translation.Properties="Content=Text.ChooseFolder"/>
                                        <Button Content="Inspect image" Click="OnInspect" Style="{StaticResource AccentButtonStyle}" local:Translation.Properties="Content=Text.InspectImage"/>
                                    </StackPanel>
                                    <ComboBox x:Name="EditionChoice" Header="Edition to build" DisplayMemberPath="Summary"
                                              SelectionChanged="OnEditionChanged" HorizontalAlignment="Stretch" local:Translation.Properties="Header=Text.EditionToBuild"/>
                                </StackPanel>
                            </Border>
                            <Grid x:Name="DownloadCard" RowSpacing="12">
                                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Button Style="{StaticResource ModeCard}" MinHeight="150" Click="OnDownloadLatest" AutomationProperties.Name="Download latest Windows 11" local:Translation.Properties="AutomationProperties.Name=Text.DownloadLatestWindows11">
                                    <Grid ColumnSpacing="24" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE896;" FontSize="52" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                        <StackPanel Grid.Column="1" Spacing="8">
                                            <TextBlock Text="Download latest Windows 11" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" local:Translation.Properties="Text=Text.DownloadLatestWindows11"/>
                                            <TextBlock x:Name="LatestDownloadDescription" Text="Official Microsoft ISO. Architecture and language selected automatically." Style="{StaticResource Secondary}" local:Translation.Properties="Text=Text.OfficialMicrosoftISOArchitectureAndLanguageSelectedAutomatically"/>
                                        </StackPanel>
                                        <FontIcon Grid.Column="2" Glyph="&#xE72A;" FontSize="24" Opacity="{ThemeResource CardArrowOpacity}"/>
                                    </Grid>
                                </Button>
                                <ProgressBar Grid.Row="1" x:Name="DownloadBar" Minimum="0" Maximum="100" Value="0" AutomationProperties.Name="Download progress" local:Translation.Properties="AutomationProperties.Name=Text.DownloadProgress"/>
                                <TextBlock Grid.Row="2" x:Name="DownloadStatus" Text="Or use an ISO you already have." Style="{StaticResource Secondary}" local:Translation.Properties="Text=Text.OrUseAnISOYouAlreadyHave"/>
                            </Grid>
                            </Grid>
                            <Expander Header="Other official downloads" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" local:Translation.Properties="Header=Text.OtherOfficialDownloads;AutomationProperties.Name=Text.OtherOfficialDownloads">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="Choose a language on Microsoft's download page, then paste the ISO download link here. Links usually expire after 24 hours."
                                               Style="{StaticResource Secondary}" local:Translation.Properties="Text=Text.ChooseALanguageOnMicrosoftSDownloadPageThen"/>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <HyperlinkButton Content="Microsoft x64 downloads ↗" NavigateUri="https://www.microsoft.com/software-download/windows11" local:Translation.Properties="Content=Text.MicrosoftX64Downloads"/>
                                        <HyperlinkButton Content="Microsoft ARM64 downloads ↗" NavigateUri="https://www.microsoft.com/software-download/windows11arm64" local:Translation.Properties="Content=Text.MicrosoftARM64Downloads"/>
                                    </StackPanel>
                                    <HyperlinkButton Content="Official Insider / Canary ISO selection ↗" NavigateUri="https://www.microsoft.com/software-download/windowsinsiderpreviewiso" Padding="0" local:Translation.Properties="Content=Text.OfficialInsiderCanaryISOSelection"/>
                                    <TextBox x:Name="DownloadUrlBox" Header="Microsoft direct ISO link" PlaceholderText="https://software.download.prss.microsoft.com/...iso?..." local:Translation.Properties="Header=Text.MicrosoftDirectISOLink;PlaceholderText=Text.HttpsSoftwareDownloadPrssMicrosoftComIso"/>
                                    <TextBox x:Name="PublishedHashBox" Header="Published SHA-256 (recommended)" PlaceholderText="Copy from Microsoft's Verify your download section" local:Translation.Properties="Header=Text.PublishedSHA256Recommended;PlaceholderText=Text.CopyFromMicrosoftSVerifyYourDownloadSection"/>
                                    <Button Content="Download ISO / resume partial" Click="OnDownload" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" local:Translation.Properties="Content=Text.DownloadISOResumePartial"/>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                        <StackPanel x:Name="CleanupPanel" Visibility="Collapsed" Spacing="18">
                            <TextBlock Text="Components" Style="{StaticResource PageHeading}" local:Translation.Properties="Text=Text.Components"/>
                            <TextBlock Text="Choose Tiny11, Tiny11 Core, or select your own removals with Custom. Every change is recorded in the build log." Style="{StaticResource Secondary}" local:Translation.Properties="Text=Text.ChooseTiny11Tiny11CoreOrSelectYourOwnRemovals"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel Spacing="14">
                                    <ComboBox x:Name="ModeChoice" Visibility="Collapsed" SelectionChanged="OnModeChanged" SelectedIndex="0">
                                        <ComboBoxItem Content="Tiny11"/>
                                        <ComboBoxItem Content="Tiny11 Core"/>
                                        <ComboBoxItem Content="Custom" local:Translation.Properties="Content=Mode.Custom"/>
                                    </ComboBox>
                                    <Grid x:Name="RemovalModeCards" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="0"/><RowDefinition Height="0"/></Grid.RowDefinitions>
                                        <Button x:Name="Tiny11Selection" Style="{StaticResource ModeCard}" MinHeight="140" Click="OnRemovalModeClick" Tag="Tiny11" AutomationProperties.Name="Use Tiny11" local:Translation.Properties="AutomationProperties.Name=Text.UseTiny11">
                                            <StackPanel Spacing="12"><FontIcon Glyph="&#xE7F4;" FontSize="48" HorizontalAlignment="Left"/><TextBlock Text="Tiny11" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Original removals. Keep update support." Style="{StaticResource Secondary}" local:Translation.Properties="Text=Text.OriginalRemovalsKeepUpdateSupport"/></StackPanel>
                                        </Button>
                                        <Button x:Name="CoreSelection" Grid.Column="1" Style="{StaticResource ModeCard}" MinHeight="140" Click="OnRemovalModeClick" Tag="Tiny11Core" AutomationProperties.Name="Use Tiny11 Core" local:Translation.Properties="AutomationProperties.Name=Text.UseTiny11Core">
                                            <StackPanel Spacing="12"><FontIcon Glyph="&#xE8B7;" FontSize="48" HorizontalAlignment="Left"/><TextBlock Text="Tiny11 Core" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Essentials only. For test VMs." Style="{StaticResource Secondary}" local:Translation.Properties="Text=Text.EssentialsOnlyForTestVMs"/></StackPanel>
                                        </Button>
                                        <Button x:Name="CustomSelection" Grid.Column="2" Style="{StaticResource ModeCard}" MinHeight="140" Click="OnRemovalModeClick" Tag="Custom" AutomationProperties.Name="Use Custom" local:Translation.Properties="AutomationProperties.Name=Text.UseCustom">
                                            <StackPanel Spacing="12"><FontIcon Glyph="&#xE713;" FontSize="48" HorizontalAlignment="Left"/><TextBlock Text="Custom" FontSize="20" FontWeight="SemiBold" local:Translation.Properties="Text=Mode.Custom"/><TextBlock Text="Choose individual removals." Style="{StaticResource Secondary}" local:Translation.Properties="Text=Text.ChooseIndividualRemovals"/></StackPanel>
                                        </Button>
                                    </Grid>
                                    <TextBlock x:Name="ModeDescription" Style="{StaticResource Secondary}"/>
                                    <InfoBar x:Name="CoreWarning" IsOpen="False" IsClosable="False" Severity="Warning" Title="Core removes update and recovery support."
                                             Message="Core deletes component files and WinRE, and disables Windows Update and Defender. Include updates, languages and features before pruning; you cannot add them afterward. Test the image in a VM." local:Translation.Properties="Title=Text.CoreRemovesUpdateAndRecoverySupport;Message=Text.CoreDeletesComponentFilesAndWinREAndDisablesWindows"/>
                                    <TextBlock x:Name="CoreConsentStatus" Visibility="Collapsed" Text="You will be asked to accept Core's limitations before continuing." Style="{StaticResource Secondary}" local:Translation.Properties="Text=Core.WillAsk"/>
                                    <TextBlock x:Name="SelectionCount" Style="{StaticResource Secondary}"/>
                                </StackPanel>
                            </Border>
                            <Expander x:Name="PresetPreview" Header="View preset removals (read-only)" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" local:Translation.Properties="Header=Text.ViewPresetRemovalsReadOnly;AutomationProperties.Name=Text.ViewPresetRemovalsReadOnly">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="These are the preset's configured actions, not components confirmed present in this image. Availability depends on the Windows version and edition. Missing items are skipped and recorded in the build log."
                                               Style="{StaticResource Secondary}" local:Translation.Properties="Text=Text.TheseAreThePresetSConfiguredActionsNotComponents"/>
                                    <TextBlock x:Name="PresetCoreDetails" Visibility="Collapsed" Text="Core also irreversibly prunes component files, removes the recovery environment, and disables Windows Update and Microsoft Defender. Updates selected in Build settings are integrated before pruning; future servicing is not supported."
                                               Style="{StaticResource Secondary}" local:Translation.Properties="Text=Text.CoreAlsoIrreversiblyPrunesComponentFilesRemovesTheRecovery"/>
                                    <ItemsControl x:Name="PresetOptionsList" AutomationProperties.Name="Preset removal groups" local:Translation.Properties="AutomationProperties.Name=Text.PresetRemovalGroups">
                                        <ItemsControl.ItemTemplate><DataTemplate>
                                            <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,8">
                                                <StackPanel Spacing="6">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Secondary}" FontSize="12"/>
                                                    <TextBlock Text="{Binding TechnicalDetail}" Style="{StaticResource Hint}" FontSize="11" IsTextSelectionEnabled="True"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Expander>
                            <StackPanel x:Name="CustomChoices" Visibility="Collapsed" Spacing="18">
                            <Button x:Name="LoadCustomRecipeButton" Content="Load recipe…" Click="OnLoadCustomRecipe"
                                    HorizontalAlignment="Left" local:Translation.Properties="Content=CustomEntry.Load;AutomationProperties.HelpText=CustomEntry.Help"/>
                            <ToggleSwitch x:Name="CustomCoreCheck" Header="Apply Core removals" OffContent="Keep servicing, recovery and Defender" OnContent="Remove servicing, recovery and Defender" Toggled="OnCustomCoreChanged" local:Translation.Properties="Header=Text.ApplyCoreRemovals;OffContent=Text.KeepServicingRecoveryAndDefender;OnContent=Text.RemoveServicingRecoveryAndDefender"/>
                            <InfoBar x:Name="NativePayloadWarning" IsOpen="False" IsClosable="False" Severity="Warning"
                                     Title="Direct file removals"
                                     Message="The selected groups can remove 32-bit support, .NET, input methods, speech or drivers. Applications and devices may stop working."
                                     local:Translation.Properties="Title=CustomMedia.DirectTitle;Message=CustomMedia.DirectWarning"/>
                            <CheckBox x:Name="NativePayloadConsent" Visibility="Collapsed" Content="I accept the risks of these direct file removals."
                                      Checked="OnChoicesChanged" Unchecked="OnChoicesChanged" local:Translation.Properties="Content=CustomMedia.DirectConsent"/>
                            <TextBlock Text="Checked groups are removed or disabled. Unchecked groups are kept. For individual items, use the component list below."
                                       Style="{StaticResource Secondary}" local:Translation.Properties="Text=Text.CheckedGroupsAreRemovedOrDisabledUncheckedGroupsAre"/>
                            <ComboBox x:Name="OptionFilter" Header="Show choices" SelectedIndex="0" SelectionChanged="OnOptionFilterChanged" HorizontalAlignment="Stretch" local:Translation.Properties="Header=Text.ShowChoices">
                                <ComboBoxItem Content="All" Tag="" local:Translation.Properties="Content=Text.All"/><ComboBoxItem Content="Bundled apps" Tag="Bundled apps" local:Translation.Properties="Content=Text.BundledApps"/><ComboBoxItem Content="Optional features" Tag="Optional features" local:Translation.Properties="Content=Stage.Optionalfeatures"/>
