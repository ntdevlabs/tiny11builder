<Application
    x:Class="Tiny11Builder.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Tiny11Builder.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/>
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                        <!-- Cancel and other critical actions: a red fill with white text, never the accent style. Every state
                             defines its own text, fill and outline, so the text cannot fall back to the default color on hover
                             or press. The Default dictionary holds the dark values. -->
                        <ResourceDictionary x:Key="Default">
                            <SolidColorBrush x:Key="CriticalButtonBackground" Color="#C42B1C"/>
                            <SolidColorBrush x:Key="CriticalButtonBackgroundPointerOver" Color="#D13A2A"/>
                            <SolidColorBrush x:Key="CriticalButtonBackgroundPressed" Color="#A32417"/>
                            <SolidColorBrush x:Key="CriticalButtonForeground" Color="#FFFFFF"/>
                            <SolidColorBrush x:Key="CriticalButtonForegroundPointerOver" Color="#FFFFFF"/>
                            <SolidColorBrush x:Key="CriticalButtonForegroundPressed" Color="#E6FFFFFF"/>
                            <SolidColorBrush x:Key="CriticalButtonBorderBrush" Color="#E8776B"/>
                            <SolidColorBrush x:Key="CriticalButtonBorderBrushPointerOver" Color="#F28C80"/>
                            <SolidColorBrush x:Key="CriticalButtonBorderBrushPressed" Color="#C95A4E"/>
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Light">
                            <SolidColorBrush x:Key="CriticalButtonBackground" Color="#C42B1C"/>
                            <SolidColorBrush x:Key="CriticalButtonBackgroundPointerOver" Color="#AE2518"/>
                            <SolidColorBrush x:Key="CriticalButtonBackgroundPressed" Color="#8F1F14"/>
                            <SolidColorBrush x:Key="CriticalButtonForeground" Color="#FFFFFF"/>
                            <SolidColorBrush x:Key="CriticalButtonForegroundPointerOver" Color="#FFFFFF"/>
                            <SolidColorBrush x:Key="CriticalButtonForegroundPressed" Color="#E6FFFFFF"/>
                            <SolidColorBrush x:Key="CriticalButtonBorderBrush" Color="#C42B1C"/>
                            <SolidColorBrush x:Key="CriticalButtonBorderBrushPointerOver" Color="#AE2518"/>
                            <SolidColorBrush x:Key="CriticalButtonBorderBrushPressed" Color="#8F1F14"/>
                        </ResourceDictionary>
                        <!-- High contrast uses only the system palette, as the standard button does. -->
                        <ResourceDictionary x:Key="HighContrast">
                            <SolidColorBrush x:Key="CriticalButtonBackground" Color="{ThemeResource SystemColorButtonFaceColor}"/>
                            <SolidColorBrush x:Key="CriticalButtonBackgroundPointerOver" Color="{ThemeResource SystemColorHighlightColor}"/>
                            <SolidColorBrush x:Key="CriticalButtonBackgroundPressed" Color="{ThemeResource SystemColorHighlightColor}"/>
                            <SolidColorBrush x:Key="CriticalButtonForeground" Color="{ThemeResource SystemColorButtonTextColor}"/>
                            <SolidColorBrush x:Key="CriticalButtonForegroundPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}"/>
                            <SolidColorBrush x:Key="CriticalButtonForegroundPressed" Color="{ThemeResource SystemColorHighlightTextColor}"/>
                            <SolidColorBrush x:Key="CriticalButtonBorderBrush" Color="{ThemeResource SystemColorButtonTextColor}"/>
                            <SolidColorBrush x:Key="CriticalButtonBorderBrushPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}"/>
                            <SolidColorBrush x:Key="CriticalButtonBorderBrushPressed" Color="{ThemeResource SystemColorHighlightTextColor}"/>
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <!-- Faint headings, labels and arrows are a deliberate look in the ordinary themes. -->
                <ResourceDictionary x:Key="Default">
                    <x:Double x:Key="WelcomeTitleOpacity">0.24</x:Double>
                    <x:Double x:Key="PageHeadingOpacity">0.28</x:Double>
                    <x:Double x:Key="ActionLabelOpacity">0.55</x:Double>
                    <x:Double x:Key="ActionArrowOpacity">0.35</x:Double>
                    <x:Double x:Key="SubtleIconOpacity">0.65</x:Double>
                    <x:Double x:Key="CardArrowOpacity">0.4</x:Double>
                </ResourceDictionary>
                <!-- High contrast needs full-strength text; the system supplies the colors. -->
                <ResourceDictionary x:Key="HighContrast">
                    <x:Double x:Key="WelcomeTitleOpacity">1</x:Double>
                    <x:Double x:Key="PageHeadingOpacity">1</x:Double>
                    <x:Double x:Key="ActionLabelOpacity">1</x:Double>
                    <x:Double x:Key="ActionArrowOpacity">1</x:Double>
                    <x:Double x:Key="SubtleIconOpacity">1</x:Double>
                    <x:Double x:Key="CardArrowOpacity">1</x:Double>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <local:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
            <local:StateVisibilityConverter x:Key="StateVisibility"/>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="Padding" Value="24"/>
            </Style>
            <Style x:Key="Secondary" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
                <Setter Property="FontSize" Value="12"/>
            </Style>
            <Style x:Key="ModeCard" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="Padding" Value="20"/>
                <Setter Property="MinHeight" Value="220"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="VerticalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            </Style>
            <Style x:Key="ModeCardSelected" TargetType="Button" BasedOn="{StaticResource ModeCard}">
                <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="Padding" Value="19"/>
            </Style>
            <Style x:Key="Section" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,12,0,4"/>
            </Style>
            <Style x:Key="PageHeading" TargetType="TextBlock">
                <Setter Property="FontSize" Value="48"/>
                <Setter Property="FontWeight" Value="Light"/>
                <Setter Property="Opacity" Value="{ThemeResource PageHeadingOpacity}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="AutomationProperties.HeadingLevel" Value="Level1"/>
            </Style>
            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="AutomationProperties.HeadingLevel" Value="Level2"/>
            </Style>
            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>
            <!-- The standard button with its own critical colors (see the Critical* brushes above). Not the accent style. -->
            <Style x:Key="CriticalButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="{ThemeResource CriticalButtonBackground}"/>
                <Setter Property="Foreground" Value="{ThemeResource CriticalButtonForeground}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CriticalButtonBorderBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter x:Name="ContentPresenter" Background="{TemplateBinding Background}" Foreground="{TemplateBinding Foreground}"
                                              BackgroundSizing="{TemplateBinding BackgroundSizing}" BorderBrush="{TemplateBinding BorderBrush}"
                                              BorderThickness="{TemplateBinding BorderThickness}" Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}" ContentTransitions="{TemplateBinding ContentTransitions}"
                                              CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                              AutomationProperties.AccessibilityView="Raw">
                                <ContentPresenter.BackgroundTransition>
                                    <BrushTransition Duration="0:0:0.083"/>
                                </ContentPresenter.BackgroundTransition>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource CriticalButtonBackgroundPointerOver}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="BorderBrush">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource CriticalButtonBorderBrushPointerOver}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource CriticalButtonForegroundPointerOver}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource CriticalButtonBackgroundPressed}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="BorderBrush">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource CriticalButtonBorderBrushPressed}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource CriticalButtonForegroundPressed}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ButtonBackgroundDisabled}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="BorderBrush">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ButtonBorderBrushDisabled}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ButtonForegroundDisabled}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </ContentPresenter>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
